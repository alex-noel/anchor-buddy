FROM ghcr.io/osgeo/gdal:ubuntu-small-3.13.3@sha256:64250faf833c06d4b21afce4c27190039ba7ab58d70f0eebc87cf77d929c0b40 AS base
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/*

FROM base AS dependencies
# Verify the package installer before running it and use Ubuntu's patched libpq at runtime.
ADD --checksum=sha256:f3b60b20ffaadd4415ed7957212a38ac63fa4c5fa375bd0f4a797777940fad13 https://files.pythonhosted.org/packages/07/25/ee8c38ae72d66b844ce8eb9711ba905dba21ca1a8a0c960057c41cd23337/pip-26.3-py3-none-any.whl /tmp/pip.whl
RUN printf '%s\n' 'psycopg==3.3.9 --hash=sha256:d2d7d04a1ce6dab4f5b27316bea3b52585cafa2f2d631e5b09dd69823f5c26f6' \
 | PYTHONPATH=/tmp/pip.whl python3 -m pip --disable-pip-version-check install \
     --no-cache-dir --require-hashes --only-binary=:all: --target /opt/ingest-deps -r /dev/stdin

FROM base
# The ingest CLI runs directly and does not use Ubuntu's bundled service manager.
RUN rm -f /usr/bin/pebble
WORKDIR /app/workers/ingest
COPY --from=dependencies /opt/ingest-deps/ /opt/ingest-deps/
COPY workers/ingest/anchor_ingest/ ./anchor_ingest/
ENV PYTHONPATH=/app/workers/ingest:/opt/ingest-deps
ENTRYPOINT ["python3", "-m", "anchor_ingest"]
CMD ["--help"]
