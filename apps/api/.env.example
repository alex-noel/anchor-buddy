PORT=3001
HOST=0.0.0.0
PACK_ROOT=./data/packs
# Use your real contact address for deployment, as requested by NWS.
NWS_USER_AGENT=Anchor Buddy-development
# Exact trusted browser origins only. Credentials are not enabled.
