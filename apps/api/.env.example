PORT=3001
HOST=0.0.0.0
PACK_ROOT=./data/packs
# Identify the public project; no personal contact details are required here.
PUBLIC_DATA_USER_AGENT=AnchorBuddy/0.1 (https://github.com/alex-noel/anchor-buddy)
NWS_USER_AGENT=AnchorBuddy/0.1 (https://github.com/alex-noel/anchor-buddy)
# Development defaults to public Overpass at low volume. Production disables
# places until OVERPASS_URL is explicitly configured for your managed/own service.
# OVERPASS_URL=https://your-overpass.example/api/interpreter
# Submitted queries only; public service has an absolute app-wide 1request/sec limit.
# Use one gateway or a shared limiter across replicas. No autocomplete.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# MET Norway global wind works without an account. Optional waves stay disabled
# until the deployment's service-use rights are explicit.
OPEN_METEO_MODE=disabled
# OPEN_METEO_MODE=noncommercial | commercial | self-hosted
# OPEN_METEO_MARINE_URL=https://customer-marine-api.open-meteo.com/v1/marine
# OPEN_METEO_API_KEY=server-side-only
# Exact trusted browser origins only. Credentials are not enabled.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
# Optional operator database. Do not commit real credentials.
DATABASE_URL=postgresql://anchorbuddy:CHANGE_ME@localhost:5432/anchorbuddy
