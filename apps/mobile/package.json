{
  "name": "@anchor-buddy/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "preweb": "node ../../scripts/prepare-web.mjs",
    "preexport:web": "node ../../scripts/prepare-web.mjs",
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@anchor-buddy/domain": "*",
    "@anchor-buddy/anchor-watch": "*",
    "expo": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@expo/vector-icons": "^15.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "expo-dev-client": "~58.0.17",
    "expo-sqlite": "~58.0.14",
    "expo-secure-store": "~58.0.2",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-location": "~58.0.20",
    "expo-font": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "../../modules"
    }
  }
}
